rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // agent_log is server-only (Admin SDK). A separate `if false` match would not
    // override this wildcard, because matching allows are OR-ed.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && document.split('/')[0] != 'agent_log';
    }
  }
}
